# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Placeholders only: never commit real values. Set each one for every Vercel environment that needs it
# (Production and Preview; UAT preview deployments use Preview), then redeploy.

# Database (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"
PIMS_DATABASE_URL="postgresql://user:password@host:5432/pims_database"

# Admin console login
JWT_SECRET="a-long-random-string"

# Mail for the contact and careers forms (lib/mailer.ts). Test the login with: npm run smtp:check
SMTP_HOST="smtp.gmail.com"
# 465 with SMTP_SECURE="true", or 587 with SMTP_SECURE="false". If SMTP_SECURE is unset, it is true only on port 465.
SMTP_PORT="465"
SMTP_SECURE="true"
# Login, usually the full email address. For Gmail, SMTP_PASSWORD is an app password, not the account password.
SMTP_USER="mailer@example.com"
SMTP_PASSWORD="app-password"
# Sender address; if unset, SMTP_USER. With Gmail it must be SMTP_USER or one of its "Send mail as" aliases.
SMTP_FROM_EMAIL="mailer@example.com"
# Inbox for contact enquiries; if unset, CAREERS_EMAIL.
CONTACT_EMAIL="enquiries@example.com"
# Inbox for careers submissions (and contact enquiries when CONTACT_EMAIL is unset).
CAREERS_EMAIL="careers@example.com"

# Careers form: résumé upload and applicant records
CLOUDINARY_CLOUD_NAME="cloud-name"
CLOUDINARY_API_KEY="api-key"
CLOUDINARY_API_SECRET="api-secret"
AIRTABLE_PERSONAL_ACCESS_TOKEN="airtable-token"
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
AIRTABLE_TABLE_NAME="Applications"

# Admin: case study import from documents (any one provider)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Base URL for lib/api.ts
NEXT_PUBLIC_API_URL=""
